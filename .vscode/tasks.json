{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start violation tracker",
            "type": "npm",
            "script": "start",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^> .*",
                    "endsPattern": "^Violation tracker portal listening on "
                }
            }
        }
    ]
}